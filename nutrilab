<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Нутрилаб</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700&family=Golos+Text:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap">
<style>
/* Layout: «клиническая карта» — шапка пациента, вкладки-разделы, рабочие панели на сетке */
:root{
  --bg:#eef2f0; --panel:#ffffff; --ink:#14231f; --muted:#5d6f69; --line:#d5dfdb;
  --accent:#0f6b5c; --accent-soft:#d6ebe5; --sun:#e2a12b; --sun-soft:#f8ead0;
  --good:#2f8a4a; --warn:#c98a10; --bad:#c2412f; --good-bg:#e1f1e5; --warn-bg:#f8edd4; --bad-bg:#f6e0dc;
  --f-display:"Unbounded","Arial Black",system-ui,sans-serif;
  --f-body:"Golos Text",system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-mono:"JetBrains Mono",ui-monospace,Menlo,Consolas,monospace;
  --r:14px;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0e1614; --panel:#16211e; --ink:#e3ece8; --muted:#8fa49d; --line:#26352f;
  --accent:#4fc2a8; --accent-soft:#173a32; --sun:#f0b54a; --sun-soft:#3a2e17;
  --good:#5cc27a; --warn:#e8b23f; --bad:#ef7a66; --good-bg:#16301f; --warn-bg:#352a12; --bad-bg:#3a1c17; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0e1614; --panel:#16211e; --ink:#e3ece8; --muted:#8fa49d; --line:#26352f;
  --accent:#4fc2a8; --accent-soft:#173a32; --sun:#f0b54a; --sun-soft:#3a2e17;
  --good:#5cc27a; --warn:#e8b23f; --bad:#ef7a66; --good-bg:#16301f; --warn-bg:#352a12; --bad-bg:#3a1c17; color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.5}
.wrap{max-width:1180px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:20px 48px}
h1,h2,h3{font-family:var(--f-display);text-wrap:balance;margin:0;letter-spacing:-.01em}
h1{font-size:clamp(22px,4vw,30px)}
h2{font-size:17px;font-weight:500}
h3{font-size:14px;font-weight:500}
.mono,.num{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.lbl{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:600}
.muted{color:var(--muted)}
header.top{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:flex-end;justify-content:space-between;margin-bottom:18px}
.brand{display:flex;gap:12px;align-items:center}
.logo{width:42px;height:42px;border-radius:12px;background:var(--accent);display:grid;place-items:center;color:var(--panel);font-family:var(--f-display);font-weight:700;font-size:18px}
.brand p{margin:2px 0 0;color:var(--muted);font-size:13px}
nav.tabs{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);display:flex;gap:6px;overflow-x:auto;padding-block:8px;margin-bottom:16px;border-bottom:1px solid var(--line)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
nav.tabs button{flex:none;border:0;background:transparent;color:var(--muted);font:600 14px var(--f-body);padding:9px 14px;border-radius:999px;cursor:pointer}
nav.tabs button[aria-selected="true"]{background:var(--ink);color:var(--bg)}
nav.tabs button:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.grid{display:grid;gap:16px}
.g2{grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr))}
.g3{grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:18px;min-width:0;display:flex;flex-direction:column;gap:14px}
.row{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.between{justify-content:space-between}
label.f{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--muted);font-weight:600;flex:1 1 120px;min-width:0}
input,select{font:500 15px var(--f-body);color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:9px 11px;width:100%}
.seg{display:flex;background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:3px;gap:3px}
.seg button{flex:1;border:0;background:transparent;color:var(--muted);font:600 13px var(--f-body);padding:7px 8px;border-radius:7px;cursor:pointer}
.seg button.on{background:var(--panel);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.12)}
.btn{border:0;background:var(--accent);color:var(--panel);font:600 14px var(--f-body);padding:10px 16px;border-radius:10px;cursor:pointer}
.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--line)}
.x{border:0;background:transparent;color:var(--muted);cursor:pointer;font-size:18px;line-height:1;padding:4px 8px;border-radius:6px}
.x:hover{background:var(--bad-bg);color:var(--bad)}
.pill{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;padding:3px 10px;border-radius:999px;white-space:nowrap}
.pill::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
.good{color:var(--good);background:var(--good-bg)} .warn{color:var(--warn);background:var(--warn-bg)} .bad{color:var(--bad);background:var(--bad-bg)}

/* BMI scale */
.scale{position:relative;height:14px;border-radius:7px;display:flex;overflow:hidden}
.scale span{height:100%}
.marker{position:absolute;top:-6px;width:4px;height:26px;background:var(--ink);border-radius:2px;transform:translateX(-50%);transition:left .4s}
.ticks{position:relative;height:16px;font-size:11px;color:var(--muted)}
.ticks span{position:absolute;transform:translateX(-50%)}
.big{font-family:var(--f-display);font-size:44px;font-weight:700;line-height:1}
.kv{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px}
.kv div{background:var(--bg);border-radius:10px;padding:10px 12px}
.kv b{display:block;font-family:var(--f-mono);font-size:20px;font-variant-numeric:tabular-nums}
.kv small{color:var(--muted);font-size:12px}
.note{font-size:13px;color:var(--muted);border-left:3px solid var(--sun);padding:6px 0 6px 12px;background:transparent}
.alert{border-radius:10px;padding:12px 14px;font-size:14px}

/* macros */
.mac{display:flex;flex-direction:column;gap:10px}
.bar{height:10px;background:var(--bg);border-radius:5px;overflow:hidden}
.bar i{display:block;height:100%;border-radius:5px;transition:width .4s}
.ring-wrap{display:flex;gap:20px;align-items:center;flex-wrap:wrap}

/* tables */
.tbl-wrap{overflow-x:auto;margin:0 -4px}
table{width:100%;border-collapse:collapse;font-size:14px}
th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:600;padding:8px 6px;border-bottom:1px solid var(--line);white-space:nowrap}
td{padding:9px 6px;border-bottom:1px solid var(--line);vertical-align:middle}
td.n,th.n{text-align:right;font-family:var(--f-mono);font-variant-numeric:tabular-nums;white-space:nowrap}
tr:last-child td{border-bottom:0}
.meal-h td{background:var(--bg);font-weight:600;font-size:13px}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{border:1px solid var(--line);background:var(--panel);color:var(--ink);font:500 13px var(--f-body);padding:6px 12px;border-radius:999px;cursor:pointer}
.chip.on{background:var(--accent-soft);border-color:var(--accent);color:var(--accent)}
.foodnote{font-size:12px;color:var(--muted)}

/* plan */
.meal{border-top:1px solid var(--line);padding-top:12px;display:flex;flex-direction:column;gap:6px}
.meal:first-of-type{border-top:0;padding-top:0}
.meal ul{margin:0;padding-left:18px}
.list-do li,.list-dont li{margin-bottom:6px}
.list-do,.list-dont{margin:0;padding-left:18px}
.list-do li::marker{color:var(--good)} .list-dont li::marker{color:var(--bad)}
svg text{font-family:var(--f-mono);fill:var(--muted);font-size:11px}
.disc{font-size:12px;color:var(--muted);margin-top:24px;text-align:left;max-width:75ch}
.view[hidden]{display:none}
/* пациенты */
.patzone{display:flex;flex-direction:column;gap:10px;margin-bottom:14px}
.patbar{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px}
.pat{flex:none;text-align:left;border:1px solid var(--line);background:var(--panel);color:var(--ink);border-radius:12px;padding:8px 14px 8px 8px;cursor:pointer;display:flex;gap:10px;align-items:center;font:inherit;max-width:260px}
.pat b{display:block;font-weight:600;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pat small{display:block;color:var(--muted);font-size:12px;white-space:nowrap}
.pat>span:last-child{min-width:0}
.pat.on{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}
.pat.add{border-style:dashed;color:var(--accent);padding:8px 14px;font-weight:600}
.ava{flex:none;width:34px;height:34px;border-radius:50%;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center;font-weight:700;font-size:13px;font-family:var(--f-display)}
.pat.on .ava{background:var(--accent);color:var(--panel)}
.btn.danger{background:transparent;color:var(--bad);border:1px solid var(--line)}
.btn.danger.solid{background:var(--bad);color:var(--panel);border-color:var(--bad)}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

<div class="wrap">
  <header class="top">
    <div class="brand">
      <div class="logo" aria-hidden="true">Н</div>
      <div>
        <h1>Нутрилаб</h1>
        <p>Рабочее место диетолога: оценка веса, норма питания, дневник и рационы</p>
      </div>
    </div>
    <div class="row" id="headSummary"></div>
  </header>

  <div class="patzone">
    <div class="row between">
      <span class="lbl" id="patCount">Пациенты</span>
      <input id="patSearch" placeholder="Найти пациента" style="width:auto;flex:0 1 220px;padding:6px 10px;font-size:14px">
    </div>
    <div class="patbar" id="patBar"></div>
    <div class="panel" id="newPat" hidden>
      <div class="row between"><h2>Новый пациент</h2><button class="x" id="npClose" aria-label="Закрыть">×</button></div>
      <div class="row">
        <label class="f" style="flex:2 1 220px">Имя и фамилия<input id="npName" placeholder="Например, Иван Петров"></label>
        <label class="f">Пол<select id="npSex"><option value="f">Женщина</option><option value="m">Мужчина</option></select></label>
        <label class="f">Возраст<input id="npAge" type="number" min="14" max="100" value="30"></label>
        <label class="f">Рост, см<input id="npHeight" type="number" min="120" max="230" value="170"></label>
        <label class="f">Вес, кг<input id="npWeight" type="number" min="30" max="300" step="0.1" value="70"></label>
        <label class="f">Цель<select id="npGoal"><option value="lose">Снизить вес</option><option value="keep" selected>Удержать</option><option value="gain">Набрать</option></select></label>
      </div>
      <div class="row"><button class="btn" id="npCreate">Создать карту</button><span class="foodnote" id="npMsg" role="status"></span></div>
    </div>
  </div>

  <nav class="tabs" role="tablist">
    <button role="tab" data-tab="card" aria-selected="true">Карта пациента</button>
    <button role="tab" data-tab="diary" aria-selected="false">Дневник питания</button>
    <button role="tab" data-tab="foods" aria-selected="false">Продукты</button>
    <button role="tab" data-tab="plan" aria-selected="false">Рацион на день</button>
    <button role="tab" data-tab="weight" aria-selected="false">Динамика веса</button>
  </nav>

  <!-- КАРТА ПАЦИЕНТА -->
  <section class="view" id="v-card">
    <div class="grid g2">
      <div class="panel">
        <div class="row between"><h2>Антропометрия</h2><span class="lbl" id="demoLbl">пример данных</span></div>
        <label class="f">Пациент<input id="pname" placeholder="Имя и фамилия"></label>
        <div class="seg" id="sexSeg"><button data-v="f">Женщина</button><button data-v="m">Мужчина</button></div>
        <div class="row">
          <label class="f">Возраст, лет<input id="age" type="number" min="14" max="100" inputmode="numeric"></label>
          <label class="f">Рост, см<input id="height" type="number" min="120" max="230" inputmode="decimal"></label>
          <label class="f">Вес, кг<input id="weight" type="number" min="30" max="300" step="0.1" inputmode="decimal"></label>
          <label class="f">Талия, см<input id="waist" type="number" min="40" max="200" inputmode="decimal"></label>
        </div>
        <label class="f">Физическая активность
          <select id="activity">
            <option value="1.2">Минимальная — сидячая работа, без тренировок</option>
            <option value="1.375">Низкая — 1–3 тренировки в неделю</option>
            <option value="1.55">Средняя — 3–5 тренировок в неделю</option>
            <option value="1.725">Высокая — 6–7 тренировок в неделю</option>
            <option value="1.9">Очень высокая — физический труд + спорт</option>
          </select>
        </label>
        <div>
          <div class="lbl" style="margin-bottom:6px">Цель</div>
          <div class="seg" id="goalSeg"><button data-v="lose">Снизить вес</button><button data-v="keep">Удержать</button><button data-v="gain">Набрать</button></div>
        </div>
        <label class="f">Целевой вес, кг<input id="target" type="number" min="30" max="300" step="0.1"></label>
        <div class="row" style="border-top:1px solid var(--line);padding-top:12px">
          <button class="btn danger" id="delAsk">Удалить карту пациента</button>
          <span id="delConfirm" class="row" hidden>
            <span style="font-size:13px" id="delText"></span>
            <button class="btn danger solid" id="delYes">Удалить</button>
            <button class="btn ghost" id="delNo">Отмена</button>
          </span>
        </div>
      </div>

      <div class="panel">
        <div class="row between"><h2>Индекс массы тела</h2><span id="bmiPill"></span></div>
        <div class="row" style="align-items:baseline;gap:14px"><div class="big num" id="bmiVal">—</div><div class="muted" id="bmiText"></div></div>
        <div>
          <div style="position:relative">
            <div class="scale" id="bmiScale"></div>
            <div class="marker" id="bmiMarker"></div>
          </div>
          <div class="ticks" id="bmiTicks"></div>
        </div>
        <div class="kv" id="bodyKv"></div>
        <div class="alert" id="weightAdvice"></div>
      </div>
    </div>

    <div class="grid g2" style="margin-top:16px">
      <div class="panel">
        <h2>Энергетическая потребность</h2>
        <div class="kv" id="energyKv"></div>
        <p class="note" id="energyNote"></p>
      </div>
      <div class="panel">
        <h2>Белки, жиры, углеводы на день</h2>
        <div class="kv" id="macroKv"></div>
        <div id="macroSplit"></div>
        <p class="note" id="macroNote"></p>
      </div>
    </div>
  </section>

  <!-- ДНЕВНИК -->
  <section class="view" id="v-diary" hidden>
    <div class="grid g2">
      <div class="panel">
        <div class="row between"><h2>Итог дня</h2><input id="diaryDate" type="date" style="width:auto"></div>
        <div class="ring-wrap">
          <svg id="ring" width="150" height="150" viewBox="0 0 150 150" role="img" aria-label="Калории за день"></svg>
          <div class="mac" id="diaryMacros" style="flex:1 1 200px;min-width:0"></div>
        </div>
        <div id="diaryAlert"></div>
      </div>
      <div class="panel">
        <h2>Добавить приём пищи</h2>
        <label class="f">Продукт<input id="foodSearch" list="foodList" placeholder="Начните вводить: гречка, творог, курица…"></label>
        <datalist id="foodList"></datalist>
        <div class="row">
          <label class="f">Граммы<input id="grams" type="number" min="1" max="2000" value="150" inputmode="numeric"></label>
          <label class="f">Приём<select id="mealSel"><option>Завтрак</option><option>Обед</option><option>Перекус</option><option>Ужин</option></select></label>
        </div>
        <div class="row"><button class="btn" id="addFood">Добавить в дневник</button><span class="muted" id="addPreview" style="font-size:13px"></span></div>
        <div class="foodnote" id="addMsg" role="status"></div>
      </div>
    </div>
    <div class="panel" style="margin-top:16px">
      <h2>Записи</h2>
      <div class="tbl-wrap"><table>
        <thead><tr><th>Продукт</th><th class="n">г</th><th class="n">ккал</th><th class="n">Б</th><th class="n">Ж</th><th class="n">У</th><th></th></tr></thead>
        <tbody id="diaryBody"></tbody>
      </table></div>
    </div>
  </section>

  <!-- ПРОДУКТЫ -->
  <section class="view" id="v-foods" hidden>
    <div class="panel">
      <div class="row between">
        <h2>База продуктов</h2>
        <span class="muted" style="font-size:13px">Оценка пересчитывается под цель пациента: <b id="goalName"></b></span>
      </div>
      <input id="foodFilter" placeholder="Поиск продукта">
      <div class="chips" id="catChips"></div>
      <div class="chips" id="verdictChips"></div>
      <div class="tbl-wrap"><table>
        <thead><tr><th>Продукт</th><th class="n">ккал</th><th class="n">Б</th><th class="n">Ж</th><th class="n">У</th><th>Оценка</th><th>Комментарий</th></tr></thead>
        <tbody id="foodsBody"></tbody>
      </table></div>
      <p class="foodnote">Значения на 100 г съедобной части, по усреднённым справочным данным. Для готовых блюд и марок ориентируйтесь на упаковку.</p>
    </div>
  </section>

  <!-- РАЦИОН -->
  <section class="view" id="v-plan" hidden>
    <div class="grid g2">
      <div class="panel">
        <div class="row between"><h2 id="planTitle">Рацион</h2><span class="pill good" id="planKcal"></span></div>
        <div class="seg" id="planVar"><button data-v="0">Вариант A</button><button data-v="1">Вариант B</button></div>
        <div id="planMeals"></div>
        <div class="row"><button class="btn ghost" id="planToDiary">Перенести в дневник на сегодня</button><span class="foodnote" id="planMsg" role="status"></span></div>
      </div>
      <div class="grid" style="align-content:start">
        <div class="panel">
          <h2>Добавить в рацион</h2>
          <ul class="list-do" id="doList"></ul>
        </div>
        <div class="panel">
          <h2>Убрать или ограничить</h2>
          <ul class="list-dont" id="dontList"></ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ВЕС -->
  <section class="view" id="v-weight" hidden>
    <div class="grid g2">
      <div class="panel" style="grid-column:1/-1">
        <div class="row between"><h2>Динамика веса</h2><span class="muted" id="trendText" style="font-size:13px"></span></div>
        <div style="overflow-x:auto"><svg id="wChart" viewBox="0 0 760 260" style="width:100%;min-width:480px;height:auto" role="img" aria-label="График веса"></svg></div>
        <div class="row" style="font-size:12px;gap:16px" >
          <span class="row" style="gap:6px"><i style="width:14px;height:10px;background:var(--good-bg);border:1px solid var(--good);display:inline-block;border-radius:2px"></i>Здоровый диапазон по ИМТ</span>
          <span class="row" style="gap:6px"><i style="width:14px;height:2px;background:var(--sun);display:inline-block"></i>Целевой вес</span>
        </div>
      </div>
      <div class="panel">
        <h2>Новое взвешивание</h2>
        <div class="row">
          <label class="f">Дата<input id="wDate" type="date"></label>
          <label class="f">Вес, кг<input id="wVal" type="number" step="0.1" min="30" max="300"></label>
        </div>
        <button class="btn" id="wAdd" style="align-self:flex-start">Записать вес</button>
        <p class="note">Взвешивайтесь утром натощак, в одно и то же время. Колебания ±1 кг за день — это вода, оценивайте среднее за неделю.</p>
