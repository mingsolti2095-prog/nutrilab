const sumOf=(food,g)=>({kcal:food.kcal*g/100,p:food.p*g/100,f:food.f*g/100,c:food.c*g/100});
function renderDiary(){
  const C=calc(), list=diary[diaryDate]||[];
  const T={kcal:0,p:0,f:0,c:0};
  const meals=['Завтрак','Обед','Перекус','Ужин'];
  let html='';
  meals.forEach(m=>{
    const items=list.map((e,i)=>({e,i})).filter(x=>x.e.m===m);
    if(!items.length) return;
    const mt={kcal:0};
    let rows='';
    items.forEach(({e,i})=>{const fd=byName[e.n];if(!fd)return;const s=sumOf(fd,e.g);mt.kcal+=s.kcal;
      ['kcal','p','f','c'].forEach(k=>T[k]+=s[k]);
      const v=verdict(fd,P.goal);
      rows+=`<tr><td>${e.n} ${v===3?'<span class="pill bad" style="margin-left:4px">убрать</span>':''}</td><td class="n">${e.g}</td><td class="n">${fmt(s.kcal)}</td><td class="n">${fmt(s.p,1)}</td><td class="n">${fmt(s.f,1)}</td><td class="n">${fmt(s.c,1)}</td><td class="n"><button class="x" data-del="${i}" aria-label="Удалить ${e.n}">×</button></td></tr>`});
    html+=`<tr class="meal-h"><td colspan="2">${m}</td><td class="n">${fmt(mt.kcal)}</td><td colspan="4"></td></tr>`+rows;
  });
  $('#diaryBody').innerHTML=html||`<tr><td colspan="7" class="muted" style="padding:20px 6px">За этот день записей нет. Добавьте первый продукт в форме выше или перенесите готовый рацион.</td></tr>`;
  // ring
  const pct=Math.min(T.kcal/C.target,1.5), R=62, L=2*Math.PI*R, over=T.kcal>C.target*1.05;
  $('#ring').innerHTML=`<circle cx="75" cy="75" r="${R}" fill="none" stroke="var(--bg)" stroke-width="12"/>
   <circle cx="75" cy="75" r="${R}" fill="none" stroke="${over?'var(--bad)':'var(--accent)'}" stroke-width="12" stroke-linecap="round" stroke-dasharray="${L*Math.min(pct,1)} ${L}" transform="rotate(-90 75 75)"/>
   <text x="75" y="72" text-anchor="middle" style="font-size:26px;font-weight:600;fill:var(--ink)">${fmt(T.kcal)}</text>
   <text x="75" y="94" text-anchor="middle">из ${fmt(Math.round(C.target/10)*10)} ккал</text>`;
  const mb=(name,v,t,col)=>`<div><div class="row between" style="font-size:13px"><span>${name}</span><span class="num">${fmt(v)} / ${fmt(t)} г</span></div><div class="bar"><i style="width:${Math.min(v/t*100,100)}%;background:${v>t*1.15?'var(--bad)':col}"></i></div></div>`;
  $('#diaryMacros').innerHTML=mb('Белки',T.p,C.prot,'var(--accent)')+mb('Жиры',T.f,C.fat,'var(--sun)')+mb('Углеводы',T.c,C.carb,'var(--muted)');
  const bads=list.filter(e=>byName[e.n]&&verdict(byName[e.n],P.goal)===3).map(e=>e.n);
  const msgs=[];
  if(T.p<C.prot*0.8&&list.length) msgs.push(['warn',`Белка не хватает ${fmt(C.prot-T.p)} г — добавьте творог, рыбу или птицу.`]);
  if(over) msgs.push(['bad',`Перебор на ${fmt(T.kcal-C.target)} ккал от цели.`]);
  if(bads.length) msgs.push(['bad',`Продукты из списка «убрать»: ${[...new Set(bads)].join(', ')}.`]);
  if(!msgs.length&&list.length) msgs.push(['good','День в рамках цели.']);
  $('#diaryAlert').innerHTML=msgs.map(m=>`<div class="alert ${m[0]}" style="margin-top:6px">${m[1]}</div>`).join('');
}
