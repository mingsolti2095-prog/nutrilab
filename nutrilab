function renderWeight(){
  weights.sort((a,b)=>a.d.localeCompare(b.d));
  const C=calc(), h=P.height/100;
  const W=760,H=260,pl=44,pr=16,pt=16,pb=30;
  const vals=weights.map(x=>x.w).concat([+P.target,C.minW,C.maxW]);
  let mn=Math.floor(Math.min(...weights.map(x=>x.w),+P.target)-2), mx=Math.ceil(Math.max(...weights.map(x=>x.w),+P.target)+2);
  const y=v=>pt+(mx-v)/(mx-mn)*(H-pt-pb);
  const n=weights.length, x=i=>pl+(n<2?0:i/(n-1))*(W-pl-pr);
  let s='';
  const bandTop=y(Math.min(C.maxW,mx)), bandBot=y(Math.max(C.minW,mn));
  if(C.maxW>mn&&C.minW<mx) s+=`<rect x="${pl}" y="${bandTop}" width="${W-pl-pr}" height="${Math.max(0,bandBot-bandTop)}" fill="var(--good-bg)"/>`;
  const step=(mx-mn)>12?4:2;
  for(let v=Math.ceil(mn/step)*step;v<=mx;v+=step){s+=`<line x1="${pl}" x2="${W-pr}" y1="${y(v)}" y2="${y(v)}" stroke="var(--line)"/><text x="${pl-8}" y="${y(v)+4}" text-anchor="end">${v}</text>`}
  if(P.target) s+=`<line x1="${pl}" x2="${W-pr}" y1="${y(P.target)}" y2="${y(P.target)}" stroke="var(--sun)" stroke-width="2" stroke-dasharray="6 5"/><text x="${W-pr}" y="${y(P.target)-6}" text-anchor="end" style="fill:var(--sun)">цель ${fmt(P.target,1)}</text>`;
  if(n){
    const pts=weights.map((p,i)=>`${x(i)},${y(p.w)}`).join(' ');
    s+=`<polygon points="${x(0)},${H-pb} ${pts} ${x(n-1)},${H-pb}" fill="var(--accent)" opacity=".1"/>`;
    s+=`<polyline points="${pts}" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linejoin="round"/>`;
    weights.forEach((p,i)=>{const last=i===n-1;s+=`<circle cx="${x(i)}" cy="${y(p.w)}" r="${last?5:3}" fill="${last?'var(--accent)':'var(--panel)'}" stroke="var(--accent)" stroke-width="2"/>`;
      if(n<=14||i%Math.ceil(n/10)===0||last) s+=`<text x="${x(i)}" y="${H-10}" text-anchor="middle">${p.d.slice(8,10)}.${p.d.slice(5,7)}</text>`});
    const l=weights[n-1]; s+=`<text x="${x(n-1)-8}" y="${y(l.w)-10}" text-anchor="end" style="fill:var(--ink);font-weight:600">${fmt(l.w,1)} кг</text>`;
  }
  $('#wChart').innerHTML=s;
  if(n>=2){const a=weights[0],b=weights[n-1],days=(new Date(b.d)-new Date(a.d))/864e5||1,perW=(b.w-a.w)/days*7;
    const left=b.w-P.target, eta=perW<0&&left>0?Math.ceil(left/-perW):null;
    $('#trendText').textContent=`${perW<=0?'−':'+'}${fmt(Math.abs(perW),2)} кг/нед · всего ${b.w-a.w<=0?'−':'+'}${fmt(Math.abs(b.w-a.w),1)} кг`+(eta?` · до цели ≈ ${eta} нед.`:'');
  } else $('#trendText').textContent='';
  $('#wBody').innerHTML=[...weights].reverse().map((p,i)=>`<tr><td class="num">${p.d.split('-').reverse().join('.')}</td><td class="n">${fmt(p.w,1)}</td><td class="n">${fmt(p.w/(h*h),1)}</td><td class="n"><button class="x" data-wdel="${p.d}" aria-label="Удалить запись">×</button></td></tr>`).join('')||`<tr><td colspan="4" class="muted">Записей пока нет</td></tr>`;
}

