});
$('#delAsk').addEventListener('click',()=>{$('#delText').textContent=`Удалить «${cur.name||'Без имени'}» вместе с дневником и взвешиваниями?`;$('#delConfirm').hidden=false;$('#delAsk').hidden=true});
$('#delNo').addEventListener('click',()=>{$('#delConfirm').hidden=true;$('#delAsk').hidden=false});
$('#delYes').addEventListener('click',()=>{
  patients=patients.filter(p=>p.id!==curId);
  if(!patients.length) patients.push({id:uid(),name:'Новый пациент',profile:Object.assign({},defaults,{waist:'',goal:'keep',weight:70,target:70,height:170,age:30}),diary:{},weights:[]});
  switchPatient(patients[0].id);
});
$('#activity').addEventListener('change',e=>{P.activity=e.target.value;all()});
$('#sexSeg').addEventListener('click',e=>{const b=e.target.closest('button');if(b){P.sex=b.dataset.v;syncInputs();all()}});
$('#goalSeg').addEventListener('click',e=>{const b=e.target.closest('button');if(b){P.goal=b.dataset.v;syncInputs();all()}});
$$('nav.tabs button').forEach(b=>b.addEventListener('click',()=>{
  $$('nav.tabs button').forEach(x=>x.setAttribute('aria-selected',x===b));
  $$('.view').forEach(v=>v.hidden=v.id!=='v-'+b.dataset.tab);
  try{history.replaceState(null,'','#'+b.dataset.tab)}catch(e){}
}));
$('#foodList').innerHTML=FOODS.map(f=>`<option value="${f.name}">`).join('');
$('#diaryDate').value=diaryDate;
$('#diaryDate').addEventListener('change',e=>{diaryDate=e.target.value||TODAY;renderDiary()});
$('#foodSearch').addEventListener('input',addPreview);$('#grams').addEventListener('input',addPreview);
$('#addFood').addEventListener('click',()=>{
  const n=$('#foodSearch').value, g=+$('#grams').value;
  if(!byName[n]){$('#addMsg').textContent='Выберите продукт из списка подсказок.';return}
  if(!(g>0)){$('#addMsg').textContent='Укажите вес порции в граммах.';return}
  (diary[diaryDate]=diary[diaryDate]||[]).push({n,g,m:$('#mealSel').value});
  $('#addMsg').textContent=`Добавлено: ${n}, ${g} г.`;$('#foodSearch').value='';addPreview();renderDiary();save();
});
$('#diaryBody').addEventListener('click',e=>{const b=e.target.closest('[data-del]');if(b){diary[diaryDate].splice(+b.dataset.del,1);renderDiary();save()}});
$('#foodFilter').addEventListener('input',renderFoods);
$('#catChips').addEventListener('click',e=>{const b=e.target.closest('[data-cat]');if(b){catFilter=b.dataset.cat;renderFoods()}});
$('#verdictChips').addEventListener('click',e=>{const b=e.target.closest('[data-verd]');if(b){verdFilter=+b.dataset.verd;renderFoods()}});
$('#planVar').addEventListener('click',e=>{const b=e.target.closest('button');if(b){planVar=+b.dataset.v;renderPlan()}});
$('#planToDiary').addEventListener('click',()=>{
  diary[TODAY]=[];planScaled().forEach(([m,items])=>items.forEach(([n,g])=>diary[TODAY].push({n,g,m})));
  diaryDate=TODAY;$('#diaryDate').value=TODAY;renderDiary();save();$('#planMsg').textContent='Готово: дневник за сегодня заполнен рационом.';
});
$('#wDate').value=TODAY;$('#wVal').value=P.weight;
$('#wAdd').addEventListener('click',()=>{const d=$('#wDate').value,w=parseFloat($('#wVal').value);if(!d||!(w>0))return;
  weights=weights.filter(x=>x.d!==d);weights.push({d,w});P.weight=w;syncInputs();all()});
$('#wBody').addEventListener('click',e=>{const b=e.target.closest('[data-wdel]');if(b){weights=weights.filter(x=>x.d!==b.dataset.wdel);renderWeight();save()}});
syncInputs();all();
const h=location.hash.slice(1);if(h){const b=document.querySelector(`nav.tabs button[data-tab="${h}"]`);if(b)b.click()}
})();
</script>

</body></html>
