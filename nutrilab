  let tot=0; base.forEach(m=>m[1].forEach(([n,g])=>tot+=byName[n].kcal*g/100));
  const k=C.target/tot;
  return base.map(([m,items])=>[m,items.map(([n,g])=>{const step=byName[n].kcal>500?5:10;return [n,Math.max(step,Math.round(g*k/step)*step)]})]);
}
function renderPlan(){
  const plan=planScaled();
