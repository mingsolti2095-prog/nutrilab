function calc(){
  const h=P.height/100, w=+P.weight, a=+P.age;
  const bmi=w/(h*h);
  const bmr=10*w+6.25*P.height-5*a+(P.sex==='m'?5:-161);
  const tdee=bmr*(+P.activity);
  let target=tdee, floor=P.sex==='m'?1500:1200;
  if(P.goal==='lose') target=Math.max(tdee*0.8,floor,bmr);
  if(P.goal==='gain') target=tdee*1.15;
  const refW=bmi>=30?Math.min(w,24.9*h*h+ (w-24.9*h*h)*0.25):w; // скорректированный вес при ожирении
  const pk=P.goal==='keep'?1.4:1.8;
  const prot=refW*pk, fat=Math.max(refW*0.9,target*0.25/9);
  const carb=Math.max((target-prot*4-fat*9)/4,50);
  const water=w*30;
  const whtr=P.waist?P.waist/P.height:null;
  return {bmi,bmr,tdee,target,prot,fat,carb,water,whtr,minW:18.5*h*h,maxW:24.9*h*h,refW};
}
function bmiCat(b){
  if(b<16) return ['Выраженный дефицит массы','bad'];
  if(b<18.5) return ['Недостаточная масса','warn'];
  if(b<25) return ['Норма','good'];
  if(b<30) return ['Избыточная масса','warn'];
  if(b<35) return ['Ожирение I степени','bad'];
  if(b<40) return ['Ожирение II степени','bad'];
  return ['Ожирение III степени','bad'];
}
